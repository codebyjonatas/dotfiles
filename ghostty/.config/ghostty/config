# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

theme = Catppuccin Macchiato

# ==============================================================================
# Multiplexer & Clipboard
# ==============================================================================

# Mouse behavior
mouse-hide-while-typing = true
mouse-reporting = true
mouse-scroll-multiplier = precision:1,discrete:3

# Scrollback
scrollback-limit = 10000000

# Shell integration
shell-integration = detect
shell-integration-features = cursor,title,path,no-sudo,no-ssh-env,no-ssh-terminfo

# ==============================================================================
# Quality of Life Keybindings
# ==============================================================================

# Split panes (matching Ghostty defaults)
# ------------------------------------------------------------------------------
# Split the current pane horizontally (down)
keybind = ctrl+shift+e=new_split:down
# Split the current pane vertically (right)
keybind = ctrl+shift+o=new_split:right

# Move between panes
# ------------------------------------------------------------------------------
# Move focus to the pane on the left
keybind = ctrl+alt+arrow_left=goto_split:left
# Move focus to the pane on the right
keybind = ctrl+alt+arrow_right=goto_split:right
# Move focus to the pane above
keybind = ctrl+alt+arrow_up=goto_split:up
# Move focus to the pane below
keybind = ctrl+alt+arrow_down=goto_split:down

# Resize panes (with 10 cell increments)
# ------------------------------------------------------------------------------
keybind = super+ctrl+shift+arrow_left=resize_split:left,10
keybind = super+ctrl+shift+arrow_right=resize_split:right,10
keybind = super+ctrl+shift+arrow_up=resize_split:up,10
keybind = super+ctrl+shift+arrow_down=resize_split:down,10

# Close panes/tabs
# ------------------------------------------------------------------------------
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+shift+q=quit

# Tab management
# ------------------------------------------------------------------------------
# Create a new tab
keybind = ctrl+shift+t=new_tab

# Switch between tabs
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Go to a specific tab (alt+number)
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=last_tab

# Terminal transparency
# ------------------------------------------------------------------------------

# Para adicionar mais transparência altere de 1.0 para 0.8
background-opacity = 0.85

# Toggle UI elements
# ------------------------------------------------------------------------------
# Toggle the tab overview
keybind = ctrl+shift+t=toggle_tab_overview
